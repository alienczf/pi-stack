{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pi-stack:jig:schema:v1:manifest",
  "title": "Jig init manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "source",
    "commandments",
    "currentState",
    "resourceIsolation",
    "transitions",
    "artifacts",
    "verification",
    "firstStep",
    "evaluation",
    "tools",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "identity", "scope"],
      "properties": {
        "root": { "const": "." },
        "identity": { "type": "string", "minLength": 1 },
        "scope": { "const": "repository" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty", "statusSummary"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "dirty": { "type": "boolean" },
        "statusSummary": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "commandments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version", "ratifiedAt"],
      "properties": {
        "path": { "const": "COMMANDMENTS.md" },
        "sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "version": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "ratifiedAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
      }
    },
    "currentState": { "$ref": "#/$defs/state" },
    "resourceIsolation": { "enum": ["isolated-shell", "inherited-session"] },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "at", "receiptPath", "receiptSha256"],
        "properties": {
          "from": { "anyOf": [{ "$ref": "#/$defs/state" }, { "const": "absent" }] },
          "to": { "$ref": "#/$defs/state" },
          "at": { "$ref": "#/$defs/timestamp" },
          "receiptPath": { "$ref": "#/$defs/relativePath" },
          "receiptSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "owner": { "enum": ["human", "controller", "jig-skill", "repository"] },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "command", "exitCode", "receiptPath", "outputSha256", "revision", "finishedAt"],
        "properties": {
          "kind": { "enum": ["deterministic", "runtime", "behavioral"] },
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
          "receiptPath": { "$ref": "#/$defs/relativePath" },
          "outputSha256": { "$ref": "#/$defs/sha256" },
          "revision": { "$ref": "#/$defs/revision" },
          "finishedAt": { "$ref": "#/$defs/timestamp" }
        }
      }
    },
    "firstStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectionPath", "selectedCandidateId", "proposalPath", "resultPath", "outcome"],
      "properties": {
        "selectionPath": { "const": ".pi/jig/steps/0001/selection.json" },
        "selectedCandidateId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "proposalPath": { "anyOf": [{ "const": ".pi/jig/steps/0001/proposal.json" }, { "type": "null" }] },
        "resultPath": { "anyOf": [{ "const": ".pi/jig/steps/0001/result.json" }, { "type": "null" }] },
        "outcome": { "enum": ["pending", "kept", "reverted", "no-eligible-candidate"] }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "verdictPath"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "enum": ["not-required", "pending", "passed", "failed", "inconclusive"] },
        "verdictPath": { "anyOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "null" }] }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jig", "pi", "python"],
      "properties": {
        "jig": { "type": "string", "minLength": 1 },
        "pi": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 }
      }
    },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "updatedAt": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "currentState": { "const": "initialized" } }, "required": ["currentState"] },
      "then": {
        "properties": {
          "firstStep": {
            "properties": {
              "resultPath": { "const": ".pi/jig/steps/0001/result.json" },
              "outcome": { "enum": ["kept", "reverted", "no-eligible-candidate"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "firstStep": { "properties": { "outcome": { "const": "no-eligible-candidate" } }, "required": ["outcome"] }
        },
        "required": ["firstStep"]
      },
      "then": {
        "properties": {
          "firstStep": {
            "properties": {
              "selectedCandidateId": { "type": "null" },
              "proposalPath": { "type": "null" },
              "resultPath": { "const": ".pi/jig/steps/0001/result.json" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "evaluation": { "properties": { "required": { "const": false } }, "required": ["required"] } }, "required": ["evaluation"] },
      "then": { "properties": { "evaluation": { "properties": { "status": { "const": "not-required" }, "verdictPath": { "type": "null" } } } } }
    },
    {
      "if": { "properties": { "evaluation": { "properties": { "required": { "const": true } }, "required": ["required"] } }, "required": ["evaluation"] },
      "then": { "properties": { "evaluation": { "properties": { "status": { "enum": ["pending", "passed", "failed", "inconclusive"] } } } } }
    },
    {
      "if": {
        "properties": {
          "currentState": { "const": "initialized" },
          "evaluation": { "properties": { "required": { "const": true } }, "required": ["required"] }
        },
        "required": ["currentState", "evaluation"]
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "status": { "const": "passed" },
              "verdictPath": { "$ref": "#/$defs/relativePath" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "currentState": { "$ref": "#/$defs/ratifiedState" } }, "required": ["currentState"] },
      "then": {
        "properties": {
          "commandments": {
            "properties": {
              "sha256": { "$ref": "#/$defs/sha256" },
              "version": { "type": "integer", "minimum": 1 },
              "ratifiedAt": { "$ref": "#/$defs/timestamp" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
    },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "ratifiedState": {
      "enum": [
        "commandments-ratified",
        "verification-building",
        "verification-ready",
        "step-selecting",
        "step-running",
        "initialized",
        "failed-commandments-ratified",
        "failed-verification-building",
        "failed-verification-ready",
        "failed-step-selecting",
        "failed-step-running"
      ]
    },
    "state": {
      "enum": [
        "surveying",
        "awaiting-commandments",
        "commandments-ratified",
        "verification-building",
        "verification-ready",
        "step-selecting",
        "step-running",
        "initialized",
        "failed-surveying",
        "failed-awaiting-commandments",
        "failed-commandments-ratified",
        "failed-verification-building",
        "failed-verification-ready",
        "failed-step-selecting",
        "failed-step-running"
      ]
    }
  }
}
