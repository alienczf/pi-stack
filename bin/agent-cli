#!/usr/bin/env python3
"""Select the pi-web or Prime CLI without changing caller arguments."""
from __future__ import annotations

import json
import os
import sys


def fail(message: str, backend: str) -> int:
    print(
        json.dumps(
            {
                "ok": False,
                "status": None,
                "error": message,
                "errorKind": "backend_unavailable",
                "effectState": "none",
                "backend": backend,
            },
            ensure_ascii=False,
            indent=2,
        )
    )
    return 1


def main(argv: list[str]) -> int:
    backend = os.environ.get("PI_STACK_BACKEND") or "pi"
    if backend not in {"pi", "prime"}:
        return fail("PI_STACK_BACKEND must be pi or prime", backend)
    executable = "pi-web-cli" if backend == "pi" else "prime-cli"
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), executable)
    if not os.path.isfile(path):
        return fail(f"Selected {backend} CLI is missing at {path}", backend)
    try:
        os.execv(sys.executable, [sys.executable, path, *argv])
    except OSError as error:
        return fail(f"Could not start the selected {backend} CLI: {error}", backend)
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
