#!/usr/bin/env python3
"""PI WEB control plane on this host (loopback). Grok Bots SSH here and run this."""
from __future__ import annotations

import argparse
import base64
import hashlib
import json
import math
import os
import queue
import socket
import ssl
import struct
import sys
import threading
import time
from dataclasses import dataclass, field
from typing import Literal
import urllib.error
import urllib.parse
import urllib.request

from collections.abc import Callable

BASE = os.environ.get("PI_WEB_URL", "http://127.0.0.1:8504").rstrip("/")


def req(method: str, path: str, body: dict | None = None, timeout: float = 20) -> tuple[int, object]:
    data = None
    headers = {}
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    r = urllib.request.Request(BASE + path, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(r, timeout=timeout) as resp:
            raw = resp.read()
            code = resp.status
    except urllib.error.HTTPError as e:
        raw = e.read()
        code = e.code
    text = raw.decode("utf-8", "replace")
    if text.lstrip().startswith("<!") or text.lstrip().lower().startswith("<!doctype"):
        return code, {"ok": False, "error": "html_not_api", "path": path, "status": code}
    try:
        parsed = json.loads(text) if text.strip() else None
    except json.JSONDecodeError:
        parsed = {"ok": False, "error": "non_json", "status": code, "body": text[:500]}
    return code, parsed


def out(obj: object, ok: bool) -> int:
    print(json.dumps(obj, indent=2))
    return 0 if ok else 1


def cmd_list(cwd: str | None) -> int:
    path = "/api/sessions"
    if cwd:
        path += "?" + urllib.parse.urlencode({"cwd": cwd})
    code, data = req("GET", path)
    ok = code == 200 and not (isinstance(data, dict) and data.get("error"))
    return out({"ok": ok, "status": code, "sessions": data}, ok)


def cmd_spawn(cwd: str, creation_token: str | None = None) -> int:
    body = {"cwd": cwd}
    if creation_token is not None:
        body["startupToken"] = creation_token
    code, data = req("POST", "/api/sessions", body)
    ok = code in (200, 201) and isinstance(data, dict) and "id" in data
    return out({"ok": ok, "status": code, "session": data}, ok)


def cmd_prompt(sid: str, text: str, streaming: str | None = None, delivery_id: str | None = None, automatic: dict | None = None, poteto_goal: str | None = None, replacement: dict | None = None) -> int:
    body = {"text": text} if streaming is None else {"text": text, "streamingBehavior": streaming}
    if poteto_goal is not None:
        body["potetoGoal"] = poteto_goal
    if replacement is not None:
        body["replacementAdmission"] = replacement
    if delivery_id is not None:
        body["deliveryId"] = delivery_id
    if automatic is not None:
        if delivery_id is None:
            return out({"ok": False, "error": "automatic admission requires a caller-persisted delivery id"}, False)
        body["automaticAdmission"] = automatic
    code, data = req("POST", f"/api/sessions/{sid}/prompt", body)
    accepted = code == 200 and isinstance(data, dict) and data.get("accepted") is True
    ok = accepted and (delivery_id is None or data.get("deliveryId") == delivery_id)
    return out({"ok": ok, "transportAccepted": accepted, "status": code, "result": data}, ok)


def cmd_status(sid: str) -> int:
    code, data = req("GET", f"/api/sessions/{sid}/status")
    ok = code == 200 and isinstance(data, dict) and not data.get("error")
    return out({"ok": ok, "status": code, "session": data}, ok)


def cmd_commands(sid: str) -> int:
    code, data = req("GET", f"/api/sessions/{sid}/commands")
    ok = code == 200 and isinstance(data, list)
    return out({"ok": ok, "status": code, "commands": data}, ok)


def _status_settings(data: object) -> tuple[str, str, str] | None:
    if not isinstance(data, dict) or data.get("error"):
        return None
    model = data.get("model")
    provider = model.get("provider") if isinstance(model, dict) else None
    model_id = model.get("id") if isinstance(model, dict) else None
    thinking = data.get("thinkingLevel")
    if not isinstance(provider, str) or provider == "" or not isinstance(model_id, str) or model_id == "" or not isinstance(thinking, str) or thinking == "":
        return None
    return provider, model_id, thinking


def _fork_choice(data: object) -> tuple[str, list[str]] | None:
    if not isinstance(data, dict) or data.get("type") != "select":
        return None
    request_id = data.get("requestId")
    options = data.get("options")
    if not isinstance(request_id, str) or request_id == "" or not isinstance(options, list) or not options:
        return None
    values: list[str] = []
    for option in options:
        if not isinstance(option, dict):
            return None
        value = option.get("value")
        if not isinstance(value, str) or value == "":
            return None
        values.append(value)
    return request_id, values


def _done_session_id(data: object) -> str | None:
    if not isinstance(data, dict) or data.get("type") != "done":
        return None
    session = data.get("session")
    if not isinstance(session, dict):
        return None
    session_id = session.get("id")
    if not isinstance(session_id, str) or session_id == "":
        return None
    return session_id


def _fork_unrestored(status: int, session_id: str, entry_id: str) -> int:
    return out({
        "ok": False,
        "status": status,
        "session": {"id": session_id, "entryId": entry_id},
        "error": "forked session settings are unconfirmed",
    }, False)


def cmd_fork(sid: str, at: str | None) -> int:
    quoted = urllib.parse.quote(sid, safe="")
    code, data = req("GET", f"/api/sessions/{quoted}/status")
    source = _status_settings(data) if code == 200 else None
    if source is None:
        return out({"ok": False, "status": code, "error": "session status has no model and thinking level"}, False)
    provider, model_id, thinking = source
    code, data = req("POST", f"/api/sessions/{quoted}/commands/run", {"text": "/fork"})
    if isinstance(data, dict) and data.get("type") == "unsupported":
        message = data.get("message")
        if not isinstance(message, str) or message == "":
            message = "fork is unsupported"
        return out({"ok": False, "status": code, "error": message}, False)
    choice = _fork_choice(data) if code == 200 else None
    if choice is None:
        return out({"ok": False, "status": code, "error": "fork did not return a user-message choice"}, False)
    request_id, values = choice
    if at is None:
        entry = values[0]
    elif at in values:
        entry = at
    else:
        return out({"ok": False, "status": code, "error": "entry is not a fork option"}, False)
    code, data = req("POST", f"/api/sessions/{quoted}/commands/respond", {"requestId": request_id, "value": entry}, timeout=120)
    new_id = _done_session_id(data) if code == 200 else None
    if new_id is None or new_id == sid:
        error = "fork returned the source session" if new_id == sid else "fork did not create a session"
        return out({"ok": False, "status": code, "error": error}, False)
    forked = urllib.parse.quote(new_id, safe="")
    code, data = req("GET", f"/api/sessions/{forked}/status")
    current = _status_settings(data) if code == 200 else None
    if current is None:
        return _fork_unrestored(code, new_id, entry)
    if (current[0], current[1]) != (provider, model_id):
        code, data = req("POST", f"/api/sessions/{forked}/model", {"provider": provider, "modelId": model_id})
        current = _status_settings(data) if code == 200 else None
        if current is None or (current[0], current[1]) != (provider, model_id):
            return _fork_unrestored(code, new_id, entry)
    if current[2] != thinking:
        code, data = req("POST", f"/api/sessions/{forked}/thinking-level", {"level": thinking})
        current = _status_settings(data) if code == 200 else None
        if current is None:
            return _fork_unrestored(code, new_id, entry)
    if current != source:
        return _fork_unrestored(code, new_id, entry)
    got_provider, got_model, got_thinking = current
    return out({
        "ok": True,
        "status": code,
        "session": {
            "id": new_id,
            "entryId": entry,
            "model": {"provider": got_provider, "id": got_model},
            "thinkingLevel": got_thinking,
        },
    }, True)


class UsageError(Exception):
    pass


def _text_input(argument: str | None) -> str:
    return argument if argument is not None else sys.stdin.buffer.read().decode("utf-8")


def _json_object(text: str, label: str) -> dict:
    try:
        value = json.loads(text)
    except json.JSONDecodeError as exc:
        raise UsageError(f"{label} must be JSON") from exc
    if not isinstance(value, dict):
        raise UsageError(f"{label} must be an object")
    return value


def _invocation_input(args: argparse.Namespace) -> tuple[str, str | None]:
    if not args.poteto:
        return _text_input(args.text), None
    if args.text is not None:
        raise UsageError("--poteto uses stdin JSON with exact text and goal, not argv goal splitting")
    value = _json_object(_text_input(None), "poteto invocation")
    if set(value) != {"text", "goal"} or not isinstance(value["text"], str) or not isinstance(value["goal"], str) or not value["goal"].strip():
        raise UsageError("poteto invocation requires exact text and nonempty goal strings")
    invocation = "/poteto-mode " + value["goal"]
    if not value["text"].endswith(invocation):
        raise UsageError("poteto invocation text does not match its exact goal")
    prefix = value["text"][:-len(invocation)]
    if prefix and not prefix.endswith("\n") or prefix.lstrip().startswith("/"):
        raise UsageError("poteto invocation must preserve a separate non-command prefix")
    return value["text"], value["goal"]


def cmd_control_goal(args: argparse.Namespace) -> int:
    sid, identity = urllib.parse.quote(args.sid, safe=""), urllib.parse.quote(args.delivery_id, safe="")
    if args.status:
        if not args.cwd:
            raise UsageError("control-goal status requires its exact cwd")
        method, body = "GET", None
        path = f"/api/sessions/{sid}/control-goal/{identity}?" + urllib.parse.urlencode({"cwd": args.cwd})
    else:
        automatic = _json_object(args.automatic_admission, "automatic admission")
        if automatic.get("sessionId") != args.sid or automatic.get("kind") not in ("wake", "recovery") or not isinstance(automatic.get("cwd"), str) or not args.run_id or args.sequence is None or args.sequence < 1:
            raise UsageError("control goal requires its exact run/transport sequence and saved generation")
        text, goal = _invocation_input(args)
        method, path = "POST", f"/api/sessions/{sid}/control-goal"
        body = {"cwd": automatic["cwd"], "id": args.delivery_id, "runId": args.run_id, "sequence": args.sequence, "text": text, "potetoGoal": goal, "automaticAdmission": automatic}
    code, data = req(method, path, body)
    ok = code == 200 and isinstance(data, dict) and not data.get("error")
    return out({"ok": ok, "status": code, "result": data}, ok)


def cmd_maintenance(args: argparse.Namespace) -> int:
    sid = urllib.parse.quote(args.sid, safe="")
    if args.cmd == "command-run":
        code, data = req("POST", f"/api/sessions/{sid}/commands/run", {"text": _text_input(args.text)})
        accepted = code == 200 and isinstance(data, dict) and data.get("type") in ("done", "select")
        return out({"ok": accepted, "commandAccepted": accepted, "status": code, "result": data}, accepted)
    if args.cmd == "compact":
        expected = _json_object(args.expected_idle, "expected idle checkpoint")
        if expected.get("sessionId") != args.sid or not isinstance(expected.get("cwd"), str):
            raise UsageError("expected checkpoint must name the exact session and cwd")
        path = f"/api/sessions/{sid}/maintenance/compact"
        body = {"cwd": expected["cwd"], "id": args.operation_id, "expectedIdle": expected, "instructions": _text_input(args.text)}
        method = "POST"
    elif args.cmd == "maintenance-events":
        path = f"/api/sessions/{sid}/maintenance/events/" + ("close" if args.close else "watch")
        body = {"cwd": args.cwd, "id": args.operation_id}
        if not args.close:
            if not args.index or not args.stream or not args.generation:
                raise UsageError("DCR event registration requires its exact index/stream/generation")
            body.update(index=args.index, stream=args.stream, generation=args.generation)
        method = "POST"
    elif args.cmd == "maintenance-resume":
        automatic = _json_object(args.automatic_admission, "automatic admission")
        if automatic.get("sessionId") != args.sid or not isinstance(automatic.get("cwd"), str) or automatic.get("kind") != "resume":
            raise UsageError("RESUME requires the saved exact session/cwd/resume generation")
        path = f"/api/sessions/{sid}/maintenance/resume"
        text, goal = _invocation_input(args)
        body = {"cwd": automatic["cwd"], "id": args.operation_id, "compactionEntryId": args.compaction_entry, "inputSequence": args.input_sequence, "automaticAdmission": automatic, "deliveryId": args.delivery_id, "text": text}
        if goal is not None:
            body["potetoGoal"] = goal
        method = "POST"
    else:
        operation = urllib.parse.quote(args.operation_id, safe="")
        path = f"/api/sessions/{sid}/maintenance/{operation}"
        method, body = ("POST", {"cwd": args.cwd}) if args.reconcile else ("GET", None)
        path += "/reconcile" if args.reconcile else "?" + urllib.parse.urlencode({"cwd": args.cwd})
    code, data = req(method, path, body)
    ok = code == 200 and isinstance(data, dict) and not data.get("error")
    return out({"ok": ok, "status": code, "result": data}, ok)


def _model_body(args: argparse.Namespace) -> dict[str, str]:
    provider, slash, model_id = args.model.partition("/")
    if slash == "" or provider == "" or model_id == "":
        raise UsageError("model must be provider/modelId")
    return {"provider": provider, "modelId": model_id}


def _archive_body(args: argparse.Namespace) -> dict[str, object]:
    if args.expected_idle is None:
        return {}
    try:
        expected = json.loads(args.expected_idle)
    except json.JSONDecodeError as exc:
        raise UsageError("expected idle checkpoint must be JSON") from exc
    if not isinstance(expected, dict):
        raise UsageError("expected idle checkpoint must be an object")
    return {"expectedIdle": expected}


def _answer_body(args: argparse.Namespace) -> dict[str, object]:
    # values holds option ids; free text goes in otherText.
    return {
        "askId": args.ask_id,
        "answers": [{"id": args.question_id, "values": [], "otherText": args.text}],
    }


VerbBuilder = Callable[[argparse.Namespace], dict | None]
VERBS: dict[str, tuple[str, str, tuple[str, ...], VerbBuilder]] = {
    "discard-empty": ("POST", "discard-empty", ("creation_token",), lambda args: {"creationToken": args.creation_token}),
    "stop": ("POST", "stop", (), lambda _args: {}),
    "abort": ("POST", "abort", (), lambda _args: {}),
    "queue-clear": ("POST", "queue/clear", (), lambda _args: {}),
    "archive": ("POST", "archive", (), _archive_body),
    "delete": ("DELETE", "", (), lambda _args: None),
    "retirement": ("GET", "retirement", (), lambda _args: None),
    "messages": ("GET", "messages", (), lambda _args: None),
    "model": ("POST", "model", ("model",), _model_body),
    "thinking-level": ("POST", "thinking-level", ("level",), lambda args: {"level": args.level}),
    "answer": ("POST", "ask/submit", ("ask_id", "question_id", "text"), _answer_body),
}


WATCH_BODY_LIMIT = 4 * 1024 * 1024
WATCH_OUTPUT_LIMIT = 1024 * 1024
WATCH_FRAME_LIMIT = 1024 * 1024
WatchKind = Literal["completed", "needs_input", "failed", "interrupted", "unknown", "timeout"]


class WatchProblem(Exception):
    pass


def watch_digest(value: object) -> str:
    raw = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False).encode("utf-8")
    return hashlib.sha256(raw).hexdigest()


def watch_remaining(deadline: float) -> float:
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise TimeoutError()
    return remaining


def watch_json(raw: bytes) -> object:
    def invalid_constant(_value: str) -> None:
        raise ValueError("nonfinite JSON")
    return json.loads(raw, parse_constant=invalid_constant)


class WatchNoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise WatchProblem("http_redirect")


def watch_get(path: str, deadline: float) -> object:
    request = urllib.request.Request(BASE + path, method="GET")
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), WatchNoRedirect())
    with opener.open(request, timeout=watch_remaining(deadline)) as response:
        if response.status != 200:
            raise WatchProblem("http_status_" + str(response.status))
        raw = response.read(WATCH_BODY_LIMIT + 1)
    if len(raw) > WATCH_BODY_LIMIT:
        raise WatchProblem("http_body_limit")
    return watch_json(raw)


def watch_id(value: object) -> str:
    if not isinstance(value, str) or not value or len(value) > 1024:
        raise WatchProblem("invalid_identifier")
    return value


def watch_status(value: object, sid: str) -> dict:
    if not isinstance(value, dict) or value.get("sessionId") != sid:
        raise WatchProblem("invalid_status_identity")
    for key in ("isStreaming", "isCompacting", "isBashRunning", "persisted"):
        if type(value.get(key)) is not bool:
            raise WatchProblem("invalid_status")
    for key in ("messageCount", "pendingMessageCount"):
        if type(value.get(key)) is not int or value[key] < 0:
            raise WatchProblem("invalid_status")
    for key in ("sessionFileDiagnostics", "queuedMessages"):
        if not isinstance(value.get(key), list):
            raise WatchProblem("invalid_status")
    if len(value["queuedMessages"]) != value["pendingMessageCount"]:
        raise WatchProblem("contradictory_queue")
    ask = value.get("pendingAsk")
    if ask is not None:
        if not isinstance(ask, dict) or not isinstance(ask.get("questions"), list) or len(ask["questions"]) > 256:
            raise WatchProblem("invalid_questions")
        watch_id(ask.get("askId"))
        for question in ask["questions"]:
            watch_id(question.get("id") if isinstance(question, dict) else None)
    dialogs = value.get("pendingDialogs", [])
    if not isinstance(dialogs, list) or len(dialogs) > 256:
        raise WatchProblem("invalid_questions")
    for dialog in dialogs:
        watch_id(dialog.get("dialogId") if isinstance(dialog, dict) else None)
    return value


def watch_questions(status: dict) -> dict:
    ask = status.get("pendingAsk") or {}
    return {"askId": ask.get("askId"), "questionIds": [question["id"] for question in ask.get("questions", [])],
            "dialogIds": [dialog["dialogId"] for dialog in status.get("pendingDialogs", [])]}


def watch_busy(status: dict) -> bool:
    return any(status[key] for key in ("isStreaming", "isCompacting", "isBashRunning", "pendingMessageCount"))


def watch_has_questions(status: dict) -> bool:
    return status.get("pendingAsk") is not None or bool(status.get("pendingDialogs"))


@dataclass
class HistoryView:
    messages: list[dict]
    digests: list[str]

    @classmethod
    def parse(cls, value: object) -> HistoryView:
        if isinstance(value, dict):
            messages = value.get("messages")
            if type(value.get("start")) is not int or type(value.get("total")) is not int or value["start"] != 0 or not isinstance(messages, list) or value["total"] != len(messages):
                raise WatchProblem("incomplete_history")
            value = messages
        if not isinstance(value, list) or len(value) > 10000:
            raise WatchProblem("invalid_history")
        for message in value:
            if not isinstance(message, dict) or message.get("role") not in ("user", "assistant", "toolResult", "system", "custom"):
                raise WatchProblem("invalid_history")
            content = message.get("content")
            if message["role"] == "user" and not isinstance(content, (str, list)):
                raise WatchProblem("invalid_history")
            if message["role"] == "assistant" and isinstance(content, list):
                for part in content:
                    if not isinstance(part, dict) or not isinstance(part.get("type"), str) or (part["type"] == "text" and not isinstance(part.get("text"), str)):
                        raise WatchProblem("invalid_history")
        return cls(value, [watch_digest(message) for message in value])


@dataclass
class EventEvidence:
    connected: bool = False
    last_seq: int | None = None
    settled_seq: int | None = None
    gaps: int = 0
    error: str | None = None
    session_error_seq: int | None = None
    errors: list[dict] = field(default_factory=list)

    def drain(self, events: queue.Queue, first: tuple | None = None) -> None:
        while True:
            if first is not None:
                kind, payload = first
                first = None
            else:
                try:
                    kind, payload = events.get_nowait()
                except queue.Empty:
                    return
            if kind == "open":
                self.connected = True
            elif kind == "gap":
                self.connected = False
                self.gaps += 1
                self.error = payload
                self.settled_seq = None
            else:
                seq, event_type, native_type, is_error, message, truncated = payload
                if event_type == "session.error":
                    self.session_error_seq = seq
                if event_type == "session.error" or is_error:
                    self.errors = (self.errors + [{"seq": seq, "type": event_type, "message": message, "messageTruncated": truncated}])[-8:]
                if self.last_seq is not None and seq != self.last_seq + 1:
                    self.gaps += 1
                    self.error = "event_sequence_gap"
                    self.settled_seq = None
                self.last_seq = seq
                if event_type == "agent.start":
                    self.settled_seq = None
                elif event_type == "pi.event" and native_type == "agent_settled":
                    self.settled_seq = seq

    def settlement(self) -> int | None:
        return self.settled_seq if self.connected and not self.gaps else None


@dataclass
class WatchState:
    sid: str
    events: EventEvidence = field(default_factory=EventEvidence)
    history: HistoryView = field(default_factory=lambda: HistoryView([], []))
    before: dict | None = None
    after: dict | None = None

    def candidate(self) -> dict | None:
        messages = self.history.messages
        index = len(messages) - 1
        while index >= 0 and messages[index]["role"] == "system" and messages[index].get("source") == "compaction":
            index -= 1
        if index < 0 or messages[index]["role"] != "assistant":
            return None
        message = messages[index]
        content = message.get("content")
        text = ""
        if isinstance(content, str):
            text = content
        elif isinstance(content, list):
            text = "\n".join(part["text"] for part in content
                             if isinstance(part, dict) and part.get("type") == "text" and isinstance(part.get("text"), str))
        reference = {"sessionId": self.sid, "historyIndex": index, "sha256": self.history.digests[index]}
        if isinstance(message.get("responseId"), str):
            reference["responseId"] = message["responseId"]
        result = {"text": text, "stopReason": message.get("stopReason"), "reference": reference}
        if isinstance(message.get("errorMessage"), str):
            result["errorMessage"] = message["errorMessage"]
        return result

    def outcome(self, kind: WatchKind, reason: str) -> dict:
        status = None if self.after is None else {key: self.after[key] for key in ("isStreaming", "isCompacting", "isBashRunning", "pendingMessageCount", "messageCount", "persisted")}
        candidate = self.candidate()
        return {"schemaVersion": 1, "kind": "watch", "ok": kind == "completed", "sessionId": self.sid,
                "outcome": kind, "reason": reason, "finalAssistant": candidate if kind == "completed" else None,
                "candidateAssistant": candidate if kind != "completed" else None,
                "questions": watch_questions(self.after or {}),
                "evidence": {"status": status, "historyCount": len(self.history.messages),
                             "events": dict(vars(self.events))}}

    def deadline_outcome(self) -> dict:
        if self.candidate() is not None and self.before is not None and self.after is not None and not watch_busy(self.before) and not watch_busy(self.after):
            return self.outcome("unknown", "settlement_unproven")
        return self.outcome("timeout", "deadline")

    def reconcile(self, history: HistoryView, settled_before: int | None) -> dict | None:
        if history.digests[:len(self.history.digests)] != self.history.digests:
            raise WatchProblem("history_boundary_changed")
        if history.messages and (history.messages[0]["role"] != "user" or sum(message["role"] == "user" for message in history.messages) != 1):
            raise WatchProblem("initial_prompt_attribution_lost")
        self.history = history
        if watch_has_questions(self.after):
            return self.outcome("needs_input", "pending_questions")
        if self.before["sessionFileDiagnostics"] or self.after["sessionFileDiagnostics"]:
            raise WatchProblem("session_file_diagnostics")
        if watch_busy(self.before) or watch_busy(self.after):
            if settled_before == self.events.settlement():
                self.events.settled_seq = None
            return None
        if not history.messages:
            return None
        # Idle precedes settlement hooks. A settlement read after this history cannot prove it final.
        if settled_before is None or settled_before != self.events.settlement():
            return None
        candidate = self.candidate()
        if candidate is None:
            return self.outcome("unknown", "no_terminal_assistant")
        stop = candidate["stopReason"]
        if stop == "error":
            return self.outcome("failed", "assistant_error")
        if stop == "aborted":
            return self.outcome("interrupted", "assistant_aborted")
        if stop != "stop":
            return self.outcome("unknown", "ambiguous_stop_reason")
        if not candidate["text"].strip():
            return self.outcome("unknown", "no_final_text")
        if not self.before["persisted"] or not self.after["persisted"]:
            return self.outcome("unknown", "history_persistence_unproven")
        if self.events.session_error_seq is not None:
            return self.outcome("unknown", "session_error_observed")
        return self.outcome("completed", "native_settled_and_reconciled")


def watch_socket(path: str, deadline: float, events: queue.Queue) -> None:
    connection = None
    try:
        origin = urllib.parse.urlsplit(BASE)
        port = origin.port or (443 if origin.scheme == "https" else 80)
        connection = socket.create_connection((origin.hostname, port), timeout=watch_remaining(deadline))
        if origin.scheme == "https":
            connection = ssl.create_default_context().wrap_socket(connection, server_hostname=origin.hostname)
        connection.settimeout(watch_remaining(deadline))
        key = base64.b64encode(os.urandom(16)).decode("ascii")
        target = (origin.path.rstrip("/") + path) or "/"
        request = f"GET {target} HTTP/1.1\r\nHost: {origin.netloc}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n"
        connection.sendall(request.encode("ascii"))

        def read_exact(size: int) -> bytes:
            data = bytearray()
            while len(data) < size:
                watch_remaining(deadline)
                chunk = connection.recv(size - len(data))
                if not chunk:
                    raise WatchProblem("websocket_disconnected")
                data.extend(chunk)
            return bytes(data)

        headers = bytearray()
        while not headers.endswith(b"\r\n\r\n"):
            if len(headers) >= 16384:
                raise WatchProblem("websocket_header_limit")
            headers.extend(read_exact(1))
        lines = headers.decode("iso-8859-1").split("\r\n")
        fields = {key.lower(): value.strip() for line in lines[1:] if ":" in line for key, value in [line.split(":", 1)]}
        expected = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode("ascii")).digest()).decode("ascii")
        if lines[0].split()[1:2] != ["101"] or fields.get("sec-websocket-accept") != expected or fields.get("upgrade", "").lower() != "websocket" or "upgrade" not in fields.get("connection", "").lower():
            raise WatchProblem("websocket_handshake")
        events.put_nowait(("open", None))
        fragments = bytearray()
        fragmented = False
        while True:
            first, second = read_exact(2)
            opcode, final = first & 15, bool(first & 128)
            if first & 112 or second & 128:
                raise WatchProblem("websocket_protocol")
            size = second & 127
            if size == 126:
                size = struct.unpack("!H", read_exact(2))[0]
            elif size == 127:
                size = struct.unpack("!Q", read_exact(8))[0]
            if size > WATCH_FRAME_LIMIT or len(fragments) + size > WATCH_FRAME_LIMIT:
                raise WatchProblem("websocket_frame_limit")
            if opcode >= 8 and (not final or size > 125):
                raise WatchProblem("websocket_protocol")
            payload = read_exact(size)
            if opcode == 8:
                raise WatchProblem("websocket_disconnected")
            if opcode == 9:
                mask = os.urandom(4)
                connection.sendall(bytes((138, 128 | size)) + mask + bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload)))
                continue
            if opcode == 10:
                continue
            if opcode not in (0, 1, 2) or (opcode == 0) != fragmented:
                raise WatchProblem("websocket_protocol")
            fragments.extend(payload)
            fragmented = not final
            if not final:
                continue
            event = watch_json(bytes(fragments))
            fragments.clear()
            if not isinstance(event, dict) or type(event.get("seq")) is not int or not 1 <= event["seq"] <= 2**53 - 1:
                raise WatchProblem("invalid_event")
            event_type, native_type = event.get("type"), event.get("eventType")
            if not isinstance(event_type, str) or len(event_type) > 128 or (native_type is not None and (not isinstance(native_type, str) or len(native_type) > 128)):
                raise WatchProblem("invalid_event")
            message = event.get("message") if isinstance(event.get("message"), str) else ""
            events.put_nowait(("event", (event["seq"], event_type, native_type, event.get("isError") is True, message[:1024], len(message) > 1024)))
    except Exception as exc:
        reason = str(exc) if isinstance(exc, WatchProblem) else "websocket_unavailable"
        try:
            events.put_nowait(("gap", reason))
        except queue.Full:
            try:
                events.get_nowait()
            except queue.Empty:
                pass
            events.put_nowait(("gap", "event_buffer_limit"))
    finally:
        if connection is not None:
            connection.close()


def watch_publish(results: queue.Queue, kind: str, result: dict) -> None:
    try:
        results.put_nowait((kind, result))
    except queue.Full:
        try:
            results.get_nowait()
        except queue.Empty:
            pass
        results.put_nowait((kind, result))


def watch_timed_out(exc: BaseException) -> bool:
    if isinstance(exc, urllib.error.URLError) and not isinstance(exc, urllib.error.HTTPError):
        exc = exc.reason
    return isinstance(exc, (TimeoutError, socket.timeout))


def watch_failure(state: WatchState, exc: Exception, deadline: float) -> dict:
    if watch_timed_out(exc):
        # Every read is bounded only by the command deadline. A timeout that fires earlier is an I/O fault, not the deadline.
        if time.monotonic() >= deadline - 0.05:
            return state.outcome("timeout", "io_deadline")
        return state.outcome("unknown", "io_timeout")
    if isinstance(exc, WatchProblem):
        reason = str(exc)
    elif isinstance(exc, urllib.error.HTTPError):
        reason = "http_status_" + str(exc.code)
    elif isinstance(exc, (ValueError, UnicodeError)):
        reason = "invalid_json"
    else:
        reason = "io_error"
    return state.outcome("unknown", reason)


def watch_worker(args: argparse.Namespace, deadline: float, results: queue.Queue) -> None:
    state = WatchState(args.sid[:1024])
    try:
        origin = urllib.parse.urlsplit(BASE)
        if len(BASE) > 4096 or origin.scheme not in ("http", "https") or not origin.hostname or origin.username is not None or origin.password is not None or origin.query or origin.fragment:
            raise WatchProblem("invalid_api_origin")
        watch_id(args.sid)
        path = "/api/sessions/" + urllib.parse.quote(args.sid, safe="")
        if args.baseline:
            state.before = watch_status(watch_get(path + "/status", deadline), args.sid)
            state.history = HistoryView.parse(watch_get(path + "/messages", deadline))
            state.after = watch_status(watch_get(path + "/status", deadline), args.sid)
            if state.history.messages or any(status["messageCount"] or watch_busy(status) or watch_has_questions(status) or status["sessionFileDiagnostics"] for status in (state.before, state.after)):
                raise WatchProblem("baseline_requires_fresh_idle_session")
            status = {key: state.after[key] for key in ("sessionId", "isStreaming", "isCompacting", "isBashRunning", "pendingMessageCount", "messageCount", "persisted", "sessionFileDiagnostics", "queuedMessages")}
            result = {"schemaVersion": 1, "kind": "baseline", "ok": True, "apiOrigin": BASE, "sessionId": args.sid,
                      "history": {"count": 0, "sha256": watch_digest([])}, "status": status, "capturedAt": time.time()}
            watch_publish(results, "done", result)
            return
        with open(args.since, "rb") as source:
            raw = source.read(65537)
        if len(raw) > 65536:
            raise WatchProblem("baseline_file_limit")
        baseline = watch_json(raw)
        if not isinstance(baseline, dict) or type(baseline.get("schemaVersion")) is not int or baseline["schemaVersion"] != 1 or baseline.get("kind") != "baseline" or baseline.get("ok") is not True or baseline.get("apiOrigin") != BASE or baseline.get("sessionId") != args.sid or baseline.get("history") != {"count": 0, "sha256": watch_digest([])}:
            raise WatchProblem("invalid_baseline")
        if type(baseline["history"]["count"]) is not int:
            raise WatchProblem("invalid_baseline")
        status = watch_status(baseline.get("status"), args.sid)
        if status["messageCount"] or watch_busy(status) or watch_has_questions(status) or status["sessionFileDiagnostics"]:
            raise WatchProblem("invalid_baseline")
        events = queue.Queue(maxsize=256)
        threading.Thread(target=watch_socket, args=(path + "/events", deadline, events), daemon=True).start()
        # Attempt subscription first, but never let a stalled upgrade prevent HTTP reconciliation.
        try:
            state.events.drain(events, events.get(timeout=min(0.1, watch_remaining(deadline))))
        except queue.Empty:
            pass
        while True:
            state.events.drain(events)
            settled_before = state.events.settlement()
            state.before = watch_status(watch_get(path + "/status", deadline), args.sid)
            history = HistoryView.parse(watch_get(path + "/messages", deadline))
            state.after = watch_status(watch_get(path + "/status", deadline), args.sid)
            state.events.drain(events)
            result = state.reconcile(history, settled_before)
            if result is not None:
                watch_publish(results, "done", result)
                return
            watch_publish(results, "progress", state.deadline_outcome())
            time.sleep(min(0.1, watch_remaining(deadline)))
    except Exception as exc:
        watch_publish(results, "done", watch_failure(state, exc, deadline))


def cmd_watch(args: argparse.Namespace) -> int:
    started = time.monotonic()
    valid_timeout = math.isfinite(args.timeout) and 0.1 <= args.timeout <= 86400
    deadline = started + (args.timeout if valid_timeout else 1.0)
    work_deadline = deadline - min(0.1, (deadline - started) / 10)
    latest = WatchState(args.sid[:1024]).outcome("timeout", "deadline")
    if valid_timeout:
        results = queue.Queue(maxsize=1)
        threading.Thread(target=watch_worker, args=(args, work_deadline, results), daemon=True).start()
        while True:
            try:
                kind, latest = results.get(timeout=watch_remaining(work_deadline))
            except (queue.Empty, TimeoutError):
                break
            if kind == "done":
                break
    else:
        latest["outcome"], latest["reason"] = "unknown", "timeout_must_be_between_0.1_and_86400"
    raw = (json.dumps(latest, separators=(",", ":"), allow_nan=False) + "\n").encode("utf-8")
    if len(raw) > WATCH_OUTPUT_LIMIT:
        latest = WatchState(args.sid[:1024]).outcome("unknown", "output_limit")
        raw = (json.dumps(latest, separators=(",", ":")) + "\n").encode("utf-8")
    written = threading.Event()

    def write_result() -> None:
        try:
            fd = sys.stdout.fileno()
            remaining = memoryview(raw)
            while remaining:
                watch_remaining(deadline)
                count = os.write(fd, remaining)
                if not count:
                    return
                remaining = remaining[count:]
            written.set()
        except (OSError, TimeoutError):
            return

    # One selected JSON result, one writer. The owner never joins stalled file, network, or output I/O.
    threading.Thread(target=write_result, daemon=True).start()
    written.wait(max(0, deadline - time.monotonic()))
    return 0 if written.is_set() and latest["ok"] else 1


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(description="PI WEB control plane (127.0.0.1:8504)")
    sub = p.add_subparsers(dest="cmd", required=True)
    ls = sub.add_parser("list")
    ls.add_argument("--cwd", required=True, help="PI WEB requires cwd; global roster is pi-intercom-cli list")
    sp = sub.add_parser("spawn")
    sp.add_argument("cwd")
    sp.add_argument("--creation-token")
    pr = sub.add_parser("prompt")
    pr.add_argument("sid")
    pr.add_argument("text", nargs="?")
    pr.add_argument("--delivery-id", help="caller-persisted correlation identity; acceptance is not application")
    pr.add_argument("--automatic-admission", help="caller-persisted exact session/cwd/generation/kind JSON; never renewed by this CLI")
    pr.add_argument("--replacement-admission", help="retired predecessor session/cwd/generation JSON")
    pr.add_argument("--poteto", action="store_true", help="stdin JSON carries exact text/goal for recipient-loaded poteto invocation")
    behavior = pr.add_mutually_exclusive_group()
    behavior.add_argument("--steer", action="store_true")
    behavior.add_argument("--follow-up", action="store_true")
    st = sub.add_parser("status")
    st.add_argument("sid")
    cm = sub.add_parser("commands")
    cm.add_argument("sid")
    fork_help = "Fork before the chosen user message the way pi /fork does. The default is the newest user message."
    fork = sub.add_parser("fork", help=fork_help, description=fork_help)
    fork.add_argument("sid")
    fork.add_argument("--at", help="User-message entry to fork before. The default is the newest user message.")
    watch = sub.add_parser("watch", help="observe one caller-owned initial prompt in a fresh session")
    watch.add_argument("sid")
    boundary = watch.add_mutually_exclusive_group(required=True)
    boundary.add_argument("--baseline", action="store_true", help="capture an empty, idle pre-prompt baseline as JSON")
    boundary.add_argument("--since", metavar="FILE", help="observe the run after an earlier baseline")
    watch.add_argument("--timeout", type=float, required=True, help="whole-command deadline in seconds, including I/O")
    control = sub.add_parser("automatic-admission")
    control.add_argument("sid")
    control.add_argument("mode", choices=("on", "off"))
    condition = control.add_mutually_exclusive_group()
    condition.add_argument("--expected-generation", help="compare the exact saved receiving epoch atomically; never renew it")
    condition.add_argument("--initialize-if-absent", action="store_true", help="create the first durable epoch only if no receiving record exists; preserve any existing epoch")
    readiness = sub.add_parser("failure-readiness")
    readiness.add_argument("sid")
    readiness.add_argument("--cwd", required=True)
    for name in ("failure-fork", "failure-maintenance", "failure-retire", "failure-resume", "failure-analysis"):
        recovery = sub.add_parser(name)
        recovery.add_argument("sid")
        recovery.add_argument("--cwd", required=True)
    boundary = sub.add_parser("failure-boundary")
    boundary.add_argument("sid")
    boundary.add_argument("--cwd", required=True)
    boundary.add_argument("--stream", required=True)
    boundary.add_argument("--root", required=True)
    boundary.add_argument("--enroll", help="JSON exact-lane role/assignment for the configured engine policy")
    goal_control = sub.add_parser("control-goal")
    goal_control.add_argument("sid")
    goal_control.add_argument("delivery_id")
    goal_control.add_argument("--run-id")
    goal_control.add_argument("--sequence", type=int)
    goal_control.add_argument("--automatic-admission")
    goal_control.add_argument("--cwd")
    goal_control.add_argument("--status", action="store_true")
    goal_control.set_defaults(poteto=True, text=None)
    sub.add_parser("runtime")
    sub.add_parser("capabilities")
    command = sub.add_parser("command-run")
    command.add_argument("sid")
    command.add_argument("text", nargs="?")
    compact = sub.add_parser("compact")
    compact.add_argument("sid")
    compact.add_argument("operation_id")
    compact.add_argument("--expected-idle", required=True)
    compact.add_argument("text", nargs="?")
    events = sub.add_parser("maintenance-events")
    events.add_argument("sid")
    events.add_argument("operation_id")
    events.add_argument("--cwd", required=True)
    events.add_argument("--index")
    events.add_argument("--stream")
    events.add_argument("--generation")
    events.add_argument("--close", action="store_true")
    maintenance = sub.add_parser("maintenance")
    maintenance.add_argument("sid")
    maintenance.add_argument("operation_id")
    maintenance.add_argument("--cwd", required=True)
    maintenance.add_argument("--reconcile", action="store_true")
    resume = sub.add_parser("maintenance-resume")
    resume.add_argument("sid")
    resume.add_argument("operation_id")
    resume.add_argument("--compaction-entry", required=True)
    resume.add_argument("--input-sequence", type=int, required=True)
    resume.add_argument("--delivery-id", required=True)
    resume.add_argument("--automatic-admission", required=True)
    resume.add_argument("--poteto", action="store_true", help="stdin JSON retains exact fixed-prefix text and goal arguments")
    resume.add_argument("text", nargs="?")
    for name, (_method, _suffix, positionals, _build) in VERBS.items():
        verb = sub.add_parser(name)
        verb.add_argument("sid")
        for positional in positionals:
            verb.add_argument(positional)
        if name == "archive":
            verb.add_argument("--expected-idle", help="exact session/cwd/logical entry/generation JSON; refuse stale or busy replacement")
    args = p.parse_args(argv)
    if args.cmd == "watch":
        # Watch writes directly to stdout. Skip finalization of its daemon I/O threads.
        os._exit(cmd_watch(args))
    if args.cmd in ("runtime", "capabilities"):
        code, data = req("GET", "/api/sessiond/runtime")
        ok = code == 200 and isinstance(data, dict) and data.get("component") == "sessiond" and isinstance(data.get("capabilities"), list) and all(isinstance(capability, str) for capability in data["capabilities"])
        missing = [capability for capability in ("sessions.maintenanceCheckpoint", "prompt.potetoArguments", "sessions.streamsDcrEvents", "prompt.controlGoal", "sessions.conditionalAdmission", "prompt.recoveryControl", "sessions.failureBoundary", "sessions.failureFork", "sessions.failureMaintenance", "sessions.failureRetirement", "sessions.resumeObservation", "sessions.engineFailureRecovery", "sessions.extensionCallbackOwnership", "sessions.streamTransientRetry") if not ok or capability not in data["capabilities"]]
        if args.cmd == "capabilities":
            ok = ok and not missing
            return out({"ok": ok, "status": code, "runtime": data, "missing": missing}, ok)
        return out({"ok": ok, "status": code, "runtime": data}, ok)
    if args.cmd == "failure-readiness":
        sid = urllib.parse.quote(args.sid, safe="")
        code, data = req("GET", f"/api/sessions/{sid}/failure-recovery/readiness?" + urllib.parse.urlencode({"cwd": args.cwd}))
        ok = code == 200 and isinstance(data, dict) and not data.get("error")
        return out({"ok": ok, "status": code, "result": data}, ok)
    if args.cmd in ("failure-fork", "failure-maintenance", "failure-retire", "failure-resume", "failure-analysis"):
        try:
            body = _json_object(_text_input(None), "engine recovery request")
        except (UsageError, UnicodeError) as exc:
            return out({"ok": False, "error": str(exc)}, False)
        body["cwd"] = args.cwd
        sid = urllib.parse.quote(args.sid, safe="")
        action = {"failure-fork": "fork", "failure-maintenance": "maintenance", "failure-retire": "retire", "failure-resume": "resume", "failure-analysis": "analysis"}[args.cmd]
        code, data = req("POST", f"/api/sessions/{sid}/failure-recovery/{action}", body)
        ok = code == 200 and isinstance(data, dict) and not data.get("error")
        return out({"ok": ok, "status": code, "result": data}, ok)
    if args.cmd == "failure-boundary":
        sid = urllib.parse.quote(args.sid, safe="")
        body = {"cwd": args.cwd, "stream": args.stream, "root": args.root}
        if args.enroll is not None:
            try:
                body["enroll"] = _json_object(args.enroll, "fresh engine-policy enrollment")
            except UsageError as exc:
                return out({"ok": False, "error": str(exc)}, False)
        code, data = req("POST", f"/api/sessions/{sid}/failure-boundary", body)
        ok = code == 200 and isinstance(data, dict) and not data.get("error")
        return out({"ok": ok, "status": code, "result": data}, ok)
    if args.cmd == "control-goal":
        try:
            return cmd_control_goal(args)
        except (UsageError, UnicodeError) as exc:
            return out({"ok": False, "error": str(exc)}, False)
    if args.cmd in ("command-run", "compact", "maintenance", "maintenance-resume", "maintenance-events"):
        try:
            return cmd_maintenance(args)
        except (UsageError, UnicodeError) as exc:
            return out({"ok": False, "error": str(exc)}, False)
    if args.cmd == "list":
        return cmd_list(args.cwd)
    if args.cmd == "spawn":
        return cmd_spawn(args.cwd, args.creation_token)
    if args.cmd == "prompt":
        try:
            text, poteto_goal = _invocation_input(args)
        except (UsageError, UnicodeError) as exc:
            return out({"ok": False, "error": str(exc)}, False)
        if not text.strip():
            return out({"ok": False, "error": "empty prompt"}, False)
        streaming = "steer" if args.steer else "followUp" if args.follow_up else None
        automatic = None
        if args.automatic_admission is not None:
            try:
                automatic = json.loads(args.automatic_admission)
            except json.JSONDecodeError:
                return out({"ok": False, "error": "automatic admission must be a JSON object"}, False)
            if not isinstance(automatic, dict):
                return out({"ok": False, "error": "automatic admission must be a JSON object"}, False)
        try:
            replacement = None if args.replacement_admission is None else _json_object(args.replacement_admission, "replacement admission")
        except UsageError as exc:
            return out({"ok": False, "error": str(exc)}, False)
        return cmd_prompt(args.sid, text, streaming, args.delivery_id, automatic, poteto_goal, replacement)
    if args.cmd == "status":
        return cmd_status(args.sid)
    if args.cmd == "commands":
        return cmd_commands(args.sid)
    if args.cmd == "fork":
        return cmd_fork(args.sid, args.at)
    if args.cmd == "automatic-admission":
        if args.initialize_if_absent and args.mode != "on":
            return out({"ok": False, "error": "initial admission requires on"}, False)
        body = {"allowed": args.mode == "on"}
        if args.initialize_if_absent:
            body["initializeIfAbsent"] = True
        if args.expected_generation is not None:
            body["expectedGeneration"] = args.expected_generation
        suffix = "/initialize" if args.initialize_if_absent else ""
        code, data = req("POST", f"/api/sessions/{args.sid}/automatic-admission{suffix}", body)
        ok = code == 200 and isinstance(data, dict) and not data.get("error")
        return out({"ok": ok, "status": code, "result": data}, ok)
    method, suffix, _positionals, build = VERBS[args.cmd]
    try:
        body = build(args)
    except UsageError as exc:
        return out({"ok": False, "error": str(exc)}, False)
    path = f"/api/sessions/{args.sid}" + (f"/{suffix}" if suffix else "")
    code, data = req(method, path, body)
    ok = code == 200 and not (isinstance(data, dict) and data.get("error"))
    return out({"ok": ok, "status": code, "result": data}, ok)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
