#!/usr/bin/env python3
"""PI WEB control plane on this host (loopback). Grok Bots SSH here and run this."""
from __future__ import annotations

import argparse
from contextlib import contextmanager
from dataclasses import dataclass
from datetime import datetime, timezone
from http.client import HTTPException
import json
import math
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import time
import uuid
import urllib.error
import urllib.parse
import urllib.request

from collections.abc import Callable

BASE = os.environ.get("PI_WEB_URL", "http://127.0.0.1:8504").rstrip("/")


def req(method: str, path: str, body: dict | None = None, timeout: float = 20) -> tuple[int, object]:
    data = None
    headers = {}
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    r = urllib.request.Request(BASE + path, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(r, timeout=timeout) as resp:
            raw = resp.read()
            code = resp.status
    except urllib.error.HTTPError as e:
        raw = e.read()
        code = e.code
    text = raw.decode("utf-8", "replace")
    if text.lstrip().startswith("<!") or text.lstrip().lower().startswith("<!doctype"):
        return code, {"ok": False, "error": "html_not_api", "path": path, "status": code}
    try:
        parsed = json.loads(text) if text.strip() else None
    except json.JSONDecodeError:
        parsed = {"ok": False, "error": "non_json", "status": code, "body": text[:500]}
    return code, parsed


def out(obj: object, ok: bool) -> int:
    print(json.dumps(obj, indent=2))
    return 0 if ok else 1


def cmd_list(cwd: str | None) -> int:
    path = "/api/sessions"
    if cwd:
        path += "?" + urllib.parse.urlencode({"cwd": cwd})
    code, data = req("GET", path)
    ok = code == 200 and not (isinstance(data, dict) and data.get("error"))
    return out({"ok": ok, "status": code, "sessions": data}, ok)


def cmd_spawn(cwd: str) -> int:
    code, data = req("POST", "/api/sessions", {"cwd": cwd})
    ok = code in (200, 201) and isinstance(data, dict) and "id" in data
    return out({"ok": ok, "status": code, "session": data}, ok)


def cmd_prompt(sid: str, text: str, streaming: str | None = None) -> int:
    body = {"text": text} if streaming is None else {"text": text, "streamingBehavior": streaming}
    code, data = req("POST", f"/api/sessions/{sid}/prompt", body)
    ok = code == 200 and isinstance(data, dict) and data.get("accepted") is True
    return out({"ok": ok, "status": code, "result": data}, ok)


def cmd_status(sid: str) -> int:
    code, data = req("GET", f"/api/sessions/{sid}/status")
    ok = code == 200 and isinstance(data, dict) and not data.get("error")
    return out({"ok": ok, "status": code, "session": data}, ok)


def cmd_commands(sid: str) -> int:
    code, data = req("GET", f"/api/sessions/{sid}/commands")
    ok = code == 200 and isinstance(data, list)
    return out({"ok": ok, "status": code, "commands": data}, ok)


class UsageError(Exception):
    pass


def _model_body(args: argparse.Namespace) -> dict[str, str]:
    provider, slash, model_id = args.model.partition("/")
    if slash == "" or provider == "" or model_id == "":
        raise UsageError("model must be provider/modelId")
    return {"provider": provider, "modelId": model_id}


def _answer_body(args: argparse.Namespace) -> dict[str, object]:
    # values holds option ids; free text goes in otherText.
    return {
        "askId": args.ask_id,
        "answers": [{"id": args.question_id, "values": [], "otherText": args.text}],
    }


VerbBuilder = Callable[[argparse.Namespace], dict | None]
VERBS: dict[str, tuple[str, str, tuple[str, ...], VerbBuilder]] = {
    "stop": ("POST", "stop", (), lambda _args: {}),
    "abort": ("POST", "abort", (), lambda _args: {}),
    "queue-clear": ("POST", "queue/clear", (), lambda _args: {}),
    "archive": ("POST", "archive", (), lambda _args: {}),
    "messages": ("GET", "messages", (), lambda _args: None),
    "model": ("POST", "model", ("model",), _model_body),
    "thinking-level": ("POST", "thinking-level", ("level",), lambda args: {"level": args.level}),
    "answer": ("POST", "ask/submit", ("ask_id", "question_id", "text"), _answer_body),
}


EVENTS = frozenset({"idle", "error", "usage_limit", "done"})
EXIT_CODES = {"idle": 0, "error": 3, "usage_limit": 4, "timeout": 124}
USAGE_LIMIT = re.compile(
    r"usage[_ -](?:limit|not[_ -]included)|GoUsageLimitError|FreeUsageLimitError|insufficient_quota|"
    r"quota exceeded|out of budget|monthly usage limit reached|available balance|"
    r"billing|exceeded.*(?:quota|budget)", re.IGNORECASE,
)


class ObservationError(Exception):
    pass


class DeadlineExpired(Exception):
    pass


@dataclass(frozen=True)
class AssistantOutcome:
    timestamp: str | int | float | None
    stop_reason: str
    error_text: str
    last_text_line: str


@dataclass(frozen=True)
class SessionObservation:
    sid: str
    cwd: str | None
    is_streaming: bool
    is_compacting: bool
    is_bash_running: bool
    pending_count: int
    context_percent: float | None
    assistant: AssistantOutcome | None

    def event(self, selected: frozenset[str]) -> str | None:
        if self.assistant and USAGE_LIMIT.search(self.assistant.error_text):
            return "usage_limit"
        if self.is_streaming or self.is_compacting or self.is_bash_running or self.pending_count:
            return None
        if self.assistant and self.assistant.stop_reason in {"error", "aborted"}:
            return "error"
        if self.assistant and self.assistant.stop_reason == "stop" and "done" in selected:
            return "done"
        return "idle" if "idle" in selected else None

    def payload(self, event: str) -> dict:
        return {
            "sid": self.sid, "cwd": self.cwd, "event": event,
            "context_percent": self.context_percent,
            "last_assistant_line": self.assistant.last_text_line[:280] if self.assistant else "",
            "ts": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        }


@contextmanager
def hard_deadline(seconds: float):
    def expire(_signum, _frame):
        raise DeadlineExpired()

    previous = signal.signal(signal.SIGALRM, expire)
    signal.setitimer(signal.ITIMER_REAL, seconds)
    try:
        yield time.monotonic() + seconds
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, _req, _fp, _code, _msg, _headers, _newurl):
        return None


HTTP = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())


def bounded_json(path: str, deadline: float, cap: int) -> object:
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise DeadlineExpired()
    try:
        with HTTP.open(BASE + path, timeout=min(10, remaining)) as response:
            if response.status != 200:
                raise ObservationError("api_status")
            raw = response.read(cap + 1)
        if len(raw) > cap:
            raise ObservationError("response_too_large")
        return json.loads(raw)
    except urllib.error.HTTPError as exc:
        exc.close()
        raise ObservationError("api_unavailable_or_invalid") from exc
    except (OSError, ValueError, RecursionError, HTTPException, urllib.error.URLError) as exc:
        raise ObservationError("api_unavailable_or_invalid") from exc


def parse_status(data: object, sid: str) -> tuple[bool, bool, bool, int, int, float | None]:
    if not isinstance(data, dict) or data.get("sessionId") != sid or data.get("error"):
        raise ObservationError("invalid_status")
    flags = tuple(data.get(key) for key in ("isStreaming", "isCompacting", "isBashRunning"))
    if any(type(value) is not bool for value in flags):
        raise ObservationError("invalid_activity")
    pending, count = data.get("pendingMessageCount"), data.get("messageCount")
    if any(type(value) is not int or value < 0 for value in (pending, count)):
        raise ObservationError("invalid_message_count")
    context = data.get("contextUsage")
    if context is not None and not isinstance(context, dict):
        raise ObservationError("invalid_context")
    percent = context.get("percent") if context else None
    if percent is not None:
        try:
            valid = type(percent) in (int, float) and math.isfinite(percent) and percent >= 0
        except OverflowError:
            valid = False
        if not valid:
            raise ObservationError("invalid_context")
    return (*flags, pending, count, percent)


def parse_assistant(data: object) -> AssistantOutcome | None:
    if not isinstance(data, dict) or not isinstance(data.get("messages"), list):
        raise ObservationError("invalid_messages")
    if any(type(data.get(key)) is not int or data[key] < 0 for key in ("start", "total")):
        raise ObservationError("invalid_messages_page")
    latest = None
    for message in data["messages"]:
        if not isinstance(message, dict):
            raise ObservationError("invalid_message")
        if message.get("role") == "user":
            latest = None
        elif message.get("role") == "assistant":
            latest = message
    if latest is None:
        return None
    reason, error, content = latest.get("stopReason"), latest.get("errorMessage", ""), latest.get("content")
    if not isinstance(reason, str) or reason not in {"stop", "length", "toolUse", "error", "aborted"} or not isinstance(error, str):
        raise ObservationError("invalid_assistant_outcome")
    if not isinstance(content, list):
        raise ObservationError("invalid_assistant_content")
    lines = []
    for block in content:
        if isinstance(block, dict) and block.get("type") == "text":
            if not isinstance(block.get("text"), str):
                raise ObservationError("invalid_assistant_text")
            lines.extend(line.strip() for line in block["text"].splitlines() if line.strip())
    timestamp = latest.get("timestamp")
    if timestamp is not None and type(timestamp) not in (str, int, float):
        raise ObservationError("invalid_assistant_timestamp")
    return AssistantOutcome(timestamp, reason, error, lines[-1] if lines else "")


def session_cwd(sid: str) -> str | None:
    root = Path(os.environ.get("PI_WEB_SESSIONS_DIR", str(Path.home() / ".pi/agent/sessions")))
    matches = set()
    for path in root.glob(f"*/*_{sid}.jsonl"):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(fd, "rb") as source:
                if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
                    continue
                raw = source.readline(8193)
                if len(raw) > 8192:
                    continue
                header = json.loads(raw)
            if (isinstance(header, dict) and header.get("type") == "session" and header.get("id") == sid
                    and isinstance(header.get("cwd"), str) and header["cwd"].startswith("/")):
                matches.add(header["cwd"])
        except (OSError, ValueError, RecursionError):
            continue
    return matches.pop() if len(matches) == 1 else None


def observe(sid: str, deadline: float, cwd: str | None) -> SessionObservation | None:
    path = f"/api/sessions/{sid}"
    first = parse_status(bounded_json(path + "/status", deadline, 262144), sid)
    assistant = parse_assistant(bounded_json(path + "/messages?limit=50", deadline, 4 * 1024 * 1024))
    second = parse_status(bounded_json(path + "/status", deadline, 262144), sid)
    if first[:5] != second[:5]:
        return None
    streaming, compacting, bash, pending, _count, percent = second
    return SessionObservation(sid, cwd, streaming, compacting, bash, pending, percent, assistant)


def watch(sid: str, timeout: float, interval: float, selected: frozenset[str]) -> tuple[SessionObservation, str]:
    with hard_deadline(timeout) as deadline:
        cwd = session_cwd(sid)
        while True:
            observation = observe(sid, deadline, cwd)
            if observation is not None:
                event = observation.event(selected)
                if event is not None:
                    return observation, event
            time.sleep(min(interval, max(0, deadline - time.monotonic())))


def cmd_wait(args: argparse.Namespace) -> int:
    try:
        observation, event = watch(args.sid, args.timeout, args.poll_interval, EVENTS - {"done"})
        print(json.dumps({"ok": event == "idle", **observation.payload(event)}))
        return EXIT_CODES[event]
    except DeadlineExpired:
        print(json.dumps({"ok": False, "sid": args.sid, "event": "timeout"}))
        return 124
    except ObservationError as exc:
        return out({"ok": False, "error": str(exc)}, False)


def private_value(path: str) -> str:
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as source:
            info = os.fstat(source.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600:
                raise UsageError("secret_file_must_be_owned_regular_0600")
            raw = source.read(8193)
        if len(raw) > 8192:
            raise UsageError("secret_file_too_large")
        value = raw.decode("ascii").removesuffix("\n")
        if not value or any(ord(char) < 32 or ord(char) > 126 for char in value):
            raise UsageError("secret_file_must_contain_one_nonempty_ascii_line")
        return value
    except (OSError, UnicodeError) as exc:
        raise UsageError("cannot_read_private_secret_file") from exc


def webhook_config(args: argparse.Namespace) -> tuple[str, str]:
    url, key = private_value(args.webhook_url_file), private_value(args.key_file)
    try:
        parsed = urllib.parse.urlsplit(url)
        port = parsed.port
        if (parsed.scheme not in {"https", "http"} or not parsed.hostname or parsed.username is not None
                or parsed.password is not None or parsed.fragment or any(char.isspace() for char in url)
                or (parsed.scheme == "http" and parsed.hostname not in {"127.0.0.1", "::1", "localhost"})
                or (port is not None and not 1 <= port <= 65535)):
            raise ValueError()
    except ValueError as exc:
        raise UsageError("webhook_requires_https_or_loopback_http_without_userinfo_or_fragment") from exc
    return url, key


def notify_log(event: str, log):
    print(datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"), event, file=log, flush=True)


def deliver(payload: bytes, args: argparse.Namespace, url: str, key: str, log) -> int:
    try:
        with hard_deadline(args.delivery_timeout) as deadline:
            for attempt in range(5):
                notify_log(f"delivery_attempt_{attempt + 1}", log)
                request = urllib.request.Request(url, data=payload, method="POST", headers={
                    "Content-Type": "application/json", args.header_name: key,
                })
                try:
                    with HTTP.open(request, timeout=min(10, max(0.001, deadline - time.monotonic()))) as response:
                        code = response.status
                except urllib.error.HTTPError as exc:
                    code = exc.code
                    exc.close()
                except (OSError, HTTPException, urllib.error.URLError):
                    code = 0
                if 200 <= code < 300:
                    notify_log("delivered", log)
                    return 0
                if code != 0 and code != 429 and not 500 <= code < 600:
                    notify_log(f"delivery_rejected_http_{code}", log)
                    return 1
                if attempt < 4:
                    time.sleep(2 ** attempt)
            notify_log("delivery_exhausted", log)
    except DeadlineExpired:
        notify_log("delivery_timeout", log)
    return 1


def notify_worker(args: argparse.Namespace) -> int:
    fd = os.open(args.log_file, os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW)
    with os.fdopen(fd, "a") as log:
        info = os.fstat(log.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600:
            return 1
        try:
            notify_log("watch_started", log)
            url, key = webhook_config(args)
            observation, event = watch(args.sid, args.watch_timeout, args.poll_interval, args.events)
            if event not in args.events:
                notify_log("terminal_event_not_selected", log)
                return 1
            payload = json.dumps(observation.payload(event), ensure_ascii=True, separators=(",", ":")).encode()
            return deliver(payload, args, url, key, log)
        except DeadlineExpired:
            notify_log("watch_timeout", log)
        except Exception:
            notify_log("watch_failed", log)
    return 1


def cmd_notify(args: argparse.Namespace) -> int:
    try:
        webhook_config(args)
        os.umask(0o077)
        root = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "pi-web-cli" / "notify"
        root.mkdir(mode=0o700, parents=True, exist_ok=True)
        for directory in (root.parent, root):
            info = directory.lstat()
            if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
                raise UsageError("notify_state_directory_must_be_owned_0700")
        unit = "pi-web-notify-" + uuid.uuid4().hex
        log = root / (unit + ".log")
        os.close(os.open(log, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600))
        command = [
            "systemd-run", "--user", "--quiet", "--collect", "--expand-environment=no", "--unit=" + unit,
            "--property=Type=exec", "--property=UMask=0077",
            "--property=StandardOutput=null", "--property=StandardError=null",
            "--property=RuntimeMaxSec=" + str(math.ceil(args.watch_timeout + args.delivery_timeout + 10)),
            "--setenv=PI_WEB_URL=" + BASE,
            "--setenv=PI_WEB_SESSIONS_DIR=" + os.environ.get("PI_WEB_SESSIONS_DIR", str(Path.home() / ".pi/agent/sessions")),
            sys.executable, str(Path(__file__).resolve()), "_notify", args.sid,
            "--webhook-url-file", os.path.abspath(args.webhook_url_file),
            "--key-file", os.path.abspath(args.key_file), "--header-name", args.header_name,
            "--events", ",".join(sorted(args.events)), "--watch-timeout", str(args.watch_timeout),
            "--delivery-timeout", str(args.delivery_timeout), "--poll-interval", str(args.poll_interval),
            "--log-file", str(log.resolve()),
        ]
        result = subprocess.run(command, capture_output=True, timeout=10)
        if result.returncode:
            raise UsageError("systemd_user_launch_failed")
        print(json.dumps({"ok": True, "unit": unit + ".service", "log_file": str(log)}))
        return 0
    except (UsageError, OSError, subprocess.SubprocessError):
        return out({"ok": False, "error": "notify_setup_or_launch_failed; check private files and systemd user manager"}, False)


def bounded_seconds(maximum: float):
    def parse(value: str) -> float:
        try:
            seconds = float(value)
        except ValueError as exc:
            raise argparse.ArgumentTypeError("expected a finite positive number") from exc
        if not math.isfinite(seconds) or not 0 < seconds <= maximum:
            raise argparse.ArgumentTypeError(f"expected 0 < seconds <= {maximum:g}")
        return seconds
    return parse


def session_id(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,127}", value):
        raise argparse.ArgumentTypeError("expected a session id")
    return value


def event_set(value: str) -> frozenset[str]:
    selected = frozenset(value.split(","))
    if not selected or not selected <= EVENTS:
        raise argparse.ArgumentTypeError("expected comma-separated idle,error,usage_limit,done")
    return selected


def header_name(value: str) -> str:
    reserved = {"host", "content-type", "content-length", "transfer-encoding", "connection", "proxy-connection", "te", "trailer", "upgrade", "expect", "proxy-authorization"}
    if not re.fullmatch(r"[!#$%&'*+.^_`|~0-9A-Za-z-]+", value) or value.lower() in reserved:
        raise argparse.ArgumentTypeError("expected an authentication header name, not a framing header")
    return value


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(description="PI WEB control plane (127.0.0.1:8504)")
    sub = p.add_subparsers(dest="cmd", required=True)
    ls = sub.add_parser("list")
    ls.add_argument("--cwd", required=True, help="PI WEB requires cwd; global roster is pi-intercom-cli list")
    sp = sub.add_parser("spawn")
    sp.add_argument("cwd")
    pr = sub.add_parser("prompt")
    pr.add_argument("sid")
    pr.add_argument("text", nargs="?")
    behavior = pr.add_mutually_exclusive_group()
    behavior.add_argument("--steer", action="store_true")
    behavior.add_argument("--follow-up", action="store_true")
    st = sub.add_parser("status")
    st.add_argument("sid")
    cm = sub.add_parser("commands")
    cm.add_argument("sid")
    wt = sub.add_parser("wait", help="one bounded check, exits 0 idle, 3 error, 4 usage limit, 124 timeout, 1 API failure")
    wt.add_argument("sid", type=session_id)
    wt.add_argument("--timeout", required=True, type=bounded_seconds(300))
    wt.add_argument("--poll-interval", type=bounded_seconds(60), default=2.0)
    for name in ("notify", "_notify"):
        nt = sub.add_parser(name, help="detach one host webhook watcher" if name == "notify" else argparse.SUPPRESS)
        nt.add_argument("sid", type=session_id)
        nt.add_argument("--webhook-url-file", required=True)
        nt.add_argument("--key-file", required=True, help="private file containing the complete authentication header value")
        nt.add_argument("--header-name", type=header_name, default="Authorization")
        nt.add_argument("--events", type=event_set, default=EVENTS)
        nt.add_argument("--once", action="store_true", help="explicit alias for the default one-payload lifecycle")
        nt.add_argument("--watch-timeout", type=bounded_seconds(86400), default=86400.0)
        nt.add_argument("--delivery-timeout", type=bounded_seconds(120), default=120.0)
        nt.add_argument("--poll-interval", type=bounded_seconds(60), default=2.0)
        if name == "_notify":
            nt.add_argument("--log-file", required=True)
    for name, (_method, _suffix, positionals, _build) in VERBS.items():
        verb = sub.add_parser(name)
        verb.add_argument("sid")
        for positional in positionals:
            verb.add_argument(positional)
    args = p.parse_args(argv)
    if args.cmd == "list":
        return cmd_list(args.cwd)
    if args.cmd == "spawn":
        return cmd_spawn(args.cwd)
    if args.cmd == "prompt":
        text = args.text if args.text is not None else sys.stdin.read()
        if not text.strip():
            return out({"ok": False, "error": "empty prompt"}, False)
        streaming = "steer" if args.steer else "followUp" if args.follow_up else None
        return cmd_prompt(args.sid, text, streaming)
    if args.cmd == "status":
        return cmd_status(args.sid)
    if args.cmd == "commands":
        return cmd_commands(args.sid)
    if args.cmd == "wait":
        return cmd_wait(args)
    if args.cmd == "notify":
        return cmd_notify(args)
    if args.cmd == "_notify":
        try:
            return notify_worker(args)
        except Exception:
            return 1
    method, suffix, _positionals, build = VERBS[args.cmd]
    try:
        body = build(args)
    except UsageError as exc:
        return out({"ok": False, "error": str(exc)}, False)
    code, data = req(method, f"/api/sessions/{args.sid}/{suffix}", body)
    ok = code == 200 and not (isinstance(data, dict) and data.get("error"))
    return out({"ok": ok, "status": code, "result": data}, ok)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
