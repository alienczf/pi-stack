#!/usr/bin/env python3
"""PI WEB control plane on this host (loopback). Grok Bots SSH here and run this."""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

from collections.abc import Callable

BASE = os.environ.get("PI_WEB_URL", "http://127.0.0.1:8504").rstrip("/")


def req(method: str, path: str, body: dict | None = None, timeout: float = 20) -> tuple[int, object]:
    data = None
    headers = {}
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    r = urllib.request.Request(BASE + path, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(r, timeout=timeout) as resp:
            raw = resp.read()
            code = resp.status
    except urllib.error.HTTPError as e:
        raw = e.read()
        code = e.code
    text = raw.decode("utf-8", "replace")
    if text.lstrip().startswith("<!") or text.lstrip().lower().startswith("<!doctype"):
        return code, {"ok": False, "error": "html_not_api", "path": path, "status": code}
    try:
        parsed = json.loads(text) if text.strip() else None
    except json.JSONDecodeError:
        parsed = {"ok": False, "error": "non_json", "status": code, "body": text[:500]}
    return code, parsed


def out(obj: object, ok: bool) -> int:
    print(json.dumps(obj, indent=2))
    return 0 if ok else 1


def cmd_list(cwd: str | None) -> int:
    path = "/api/sessions"
    if cwd:
        path += "?" + urllib.parse.urlencode({"cwd": cwd})
    code, data = req("GET", path)
    ok = code == 200 and not (isinstance(data, dict) and data.get("error"))
    return out({"ok": ok, "status": code, "sessions": data}, ok)


def cmd_spawn(cwd: str) -> int:
    code, data = req("POST", "/api/sessions", {"cwd": cwd})
    ok = code in (200, 201) and isinstance(data, dict) and "id" in data
    return out({"ok": ok, "status": code, "session": data}, ok)


def cmd_prompt(sid: str, text: str, streaming: str | None = None, delivery_id: str | None = None, automatic: dict | None = None, poteto_goal: str | None = None) -> int:
    body = {"text": text} if streaming is None else {"text": text, "streamingBehavior": streaming}
    if poteto_goal is not None:
        body["potetoGoal"] = poteto_goal
    if delivery_id is not None:
        body["deliveryId"] = delivery_id
    if automatic is not None:
        if delivery_id is None:
            return out({"ok": False, "error": "automatic admission requires a caller-persisted delivery id"}, False)
        body["automaticAdmission"] = automatic
    code, data = req("POST", f"/api/sessions/{sid}/prompt", body)
    accepted = code == 200 and isinstance(data, dict) and data.get("accepted") is True
    ok = accepted and (delivery_id is None or data.get("deliveryId") == delivery_id)
    return out({"ok": ok, "transportAccepted": accepted, "status": code, "result": data}, ok)


def cmd_status(sid: str) -> int:
    code, data = req("GET", f"/api/sessions/{sid}/status")
    ok = code == 200 and isinstance(data, dict) and not data.get("error")
    return out({"ok": ok, "status": code, "session": data}, ok)


def cmd_commands(sid: str) -> int:
    code, data = req("GET", f"/api/sessions/{sid}/commands")
    ok = code == 200 and isinstance(data, list)
    return out({"ok": ok, "status": code, "commands": data}, ok)


class UsageError(Exception):
    pass


def _text_input(argument: str | None) -> str:
    return argument if argument is not None else sys.stdin.buffer.read().decode("utf-8")


def _json_object(text: str, label: str) -> dict:
    try:
        value = json.loads(text)
    except json.JSONDecodeError as exc:
        raise UsageError(f"{label} must be JSON") from exc
    if not isinstance(value, dict):
        raise UsageError(f"{label} must be an object")
    return value


def _invocation_input(args: argparse.Namespace) -> tuple[str, str | None]:
    if not args.poteto:
        return _text_input(args.text), None
    if args.text is not None:
        raise UsageError("--poteto uses stdin JSON with exact text and goal, not argv goal splitting")
    value = _json_object(_text_input(None), "poteto invocation")
    if set(value) != {"text", "goal"} or not isinstance(value["text"], str) or not isinstance(value["goal"], str) or not value["goal"].strip():
        raise UsageError("poteto invocation requires exact text and nonempty goal strings")
    invocation = "/poteto-mode " + value["goal"]
    if not value["text"].endswith(invocation):
        raise UsageError("poteto invocation text does not match its exact goal")
    prefix = value["text"][:-len(invocation)]
    if prefix and not prefix.endswith("\n") or prefix.lstrip().startswith("/"):
        raise UsageError("poteto invocation must preserve a separate non-command prefix")
    return value["text"], value["goal"]


def cmd_control_goal(args: argparse.Namespace) -> int:
    sid, identity = urllib.parse.quote(args.sid, safe=""), urllib.parse.quote(args.delivery_id, safe="")
    if args.status:
        if not args.cwd:
            raise UsageError("control-goal status requires its exact cwd")
        method, body = "GET", None
        path = f"/api/sessions/{sid}/control-goal/{identity}?" + urllib.parse.urlencode({"cwd": args.cwd})
    else:
        automatic = _json_object(args.automatic_admission, "automatic admission")
        if automatic.get("sessionId") != args.sid or automatic.get("kind") not in ("wake", "recovery") or not isinstance(automatic.get("cwd"), str) or not args.run_id or args.sequence is None or args.sequence < 1:
            raise UsageError("control goal requires its exact run/transport sequence and saved generation")
        text, goal = _invocation_input(args)
        method, path = "POST", f"/api/sessions/{sid}/control-goal"
        body = {"cwd": automatic["cwd"], "id": args.delivery_id, "runId": args.run_id, "sequence": args.sequence, "text": text, "potetoGoal": goal, "automaticAdmission": automatic}
    code, data = req(method, path, body)
    ok = code == 200 and isinstance(data, dict) and not data.get("error")
    return out({"ok": ok, "status": code, "result": data}, ok)


def cmd_maintenance(args: argparse.Namespace) -> int:
    sid = urllib.parse.quote(args.sid, safe="")
    if args.cmd == "command-run":
        code, data = req("POST", f"/api/sessions/{sid}/commands/run", {"text": _text_input(args.text)})
        accepted = code == 200 and isinstance(data, dict) and data.get("type") in ("done", "select")
        return out({"ok": accepted, "commandAccepted": accepted, "status": code, "result": data}, accepted)
    if args.cmd == "compact":
        expected = _json_object(args.expected_idle, "expected idle checkpoint")
        if expected.get("sessionId") != args.sid or not isinstance(expected.get("cwd"), str):
            raise UsageError("expected checkpoint must name the exact session and cwd")
        path = f"/api/sessions/{sid}/maintenance/compact"
        body = {"cwd": expected["cwd"], "id": args.operation_id, "expectedIdle": expected, "instructions": _text_input(args.text)}
        method = "POST"
    elif args.cmd == "maintenance-events":
        path = f"/api/sessions/{sid}/maintenance/events/" + ("close" if args.close else "watch")
        body = {"cwd": args.cwd, "id": args.operation_id}
        if not args.close:
            if not args.index or not args.stream or not args.generation:
                raise UsageError("DCR event registration requires its exact index/stream/generation")
            body.update(index=args.index, stream=args.stream, generation=args.generation)
        method = "POST"
    elif args.cmd == "maintenance-resume":
        automatic = _json_object(args.automatic_admission, "automatic admission")
        if automatic.get("sessionId") != args.sid or not isinstance(automatic.get("cwd"), str) or automatic.get("kind") != "resume":
            raise UsageError("RESUME requires the saved exact session/cwd/resume generation")
        path = f"/api/sessions/{sid}/maintenance/resume"
        text, goal = _invocation_input(args)
        body = {"cwd": automatic["cwd"], "id": args.operation_id, "compactionEntryId": args.compaction_entry, "inputSequence": args.input_sequence, "automaticAdmission": automatic, "deliveryId": args.delivery_id, "text": text}
        if goal is not None:
            body["potetoGoal"] = goal
        method = "POST"
    else:
        operation = urllib.parse.quote(args.operation_id, safe="")
        path = f"/api/sessions/{sid}/maintenance/{operation}"
        method, body = ("POST", {"cwd": args.cwd}) if args.reconcile else ("GET", None)
        path += "/reconcile" if args.reconcile else "?" + urllib.parse.urlencode({"cwd": args.cwd})
    code, data = req(method, path, body)
    ok = code == 200 and isinstance(data, dict) and not data.get("error")
    return out({"ok": ok, "status": code, "result": data}, ok)


def _model_body(args: argparse.Namespace) -> dict[str, str]:
    provider, slash, model_id = args.model.partition("/")
    if slash == "" or provider == "" or model_id == "":
        raise UsageError("model must be provider/modelId")
    return {"provider": provider, "modelId": model_id}


def _archive_body(args: argparse.Namespace) -> dict[str, object]:
    if args.expected_idle is None:
        return {}
    try:
        expected = json.loads(args.expected_idle)
    except json.JSONDecodeError as exc:
        raise UsageError("expected idle checkpoint must be JSON") from exc
    if not isinstance(expected, dict):
        raise UsageError("expected idle checkpoint must be an object")
    return {"expectedIdle": expected}


def _answer_body(args: argparse.Namespace) -> dict[str, object]:
    # values holds option ids; free text goes in otherText.
    return {
        "askId": args.ask_id,
        "answers": [{"id": args.question_id, "values": [], "otherText": args.text}],
    }


VerbBuilder = Callable[[argparse.Namespace], dict | None]
VERBS: dict[str, tuple[str, str, tuple[str, ...], VerbBuilder]] = {
    "stop": ("POST", "stop", (), lambda _args: {}),
    "abort": ("POST", "abort", (), lambda _args: {}),
    "queue-clear": ("POST", "queue/clear", (), lambda _args: {}),
    "archive": ("POST", "archive", (), _archive_body),
    "messages": ("GET", "messages", (), lambda _args: None),
    "model": ("POST", "model", ("model",), _model_body),
    "thinking-level": ("POST", "thinking-level", ("level",), lambda args: {"level": args.level}),
    "answer": ("POST", "ask/submit", ("ask_id", "question_id", "text"), _answer_body),
}


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(description="PI WEB control plane (127.0.0.1:8504)")
    sub = p.add_subparsers(dest="cmd", required=True)
    ls = sub.add_parser("list")
    ls.add_argument("--cwd", required=True, help="PI WEB requires cwd; global roster is pi-intercom-cli list")
    sp = sub.add_parser("spawn")
    sp.add_argument("cwd")
    pr = sub.add_parser("prompt")
    pr.add_argument("sid")
    pr.add_argument("text", nargs="?")
    pr.add_argument("--delivery-id", help="caller-persisted correlation identity; acceptance is not application")
    pr.add_argument("--automatic-admission", help="caller-persisted exact session/cwd/generation/kind JSON; never renewed by this CLI")
    pr.add_argument("--poteto", action="store_true", help="stdin JSON carries exact text/goal for recipient-loaded poteto invocation")
    behavior = pr.add_mutually_exclusive_group()
    behavior.add_argument("--steer", action="store_true")
    behavior.add_argument("--follow-up", action="store_true")
    st = sub.add_parser("status")
    st.add_argument("sid")
    cm = sub.add_parser("commands")
    cm.add_argument("sid")
    control = sub.add_parser("automatic-admission")
    control.add_argument("sid")
    control.add_argument("mode", choices=("on", "off"))
    control.add_argument("--expected-generation", help="compare the exact saved receiving epoch atomically; never renew it")
    ratification = sub.add_parser("failure-ratify")
    ratification.add_argument("sid")
    ratification.add_argument("--cwd", required=True)
    boundary = sub.add_parser("failure-boundary")
    boundary.add_argument("sid")
    boundary.add_argument("--cwd", required=True)
    boundary.add_argument("--stream", required=True)
    boundary.add_argument("--root", required=True)
    goal_control = sub.add_parser("control-goal")
    goal_control.add_argument("sid")
    goal_control.add_argument("delivery_id")
    goal_control.add_argument("--run-id")
    goal_control.add_argument("--sequence", type=int)
    goal_control.add_argument("--automatic-admission")
    goal_control.add_argument("--cwd")
    goal_control.add_argument("--status", action="store_true")
    goal_control.set_defaults(poteto=True, text=None)
    sub.add_parser("runtime")
    sub.add_parser("capabilities")
    command = sub.add_parser("command-run")
    command.add_argument("sid")
    command.add_argument("text", nargs="?")
    compact = sub.add_parser("compact")
    compact.add_argument("sid")
    compact.add_argument("operation_id")
    compact.add_argument("--expected-idle", required=True)
    compact.add_argument("text", nargs="?")
    events = sub.add_parser("maintenance-events")
    events.add_argument("sid")
    events.add_argument("operation_id")
    events.add_argument("--cwd", required=True)
    events.add_argument("--index")
    events.add_argument("--stream")
    events.add_argument("--generation")
    events.add_argument("--close", action="store_true")
    maintenance = sub.add_parser("maintenance")
    maintenance.add_argument("sid")
    maintenance.add_argument("operation_id")
    maintenance.add_argument("--cwd", required=True)
    maintenance.add_argument("--reconcile", action="store_true")
    resume = sub.add_parser("maintenance-resume")
    resume.add_argument("sid")
    resume.add_argument("operation_id")
    resume.add_argument("--compaction-entry", required=True)
    resume.add_argument("--input-sequence", type=int, required=True)
    resume.add_argument("--delivery-id", required=True)
    resume.add_argument("--automatic-admission", required=True)
    resume.add_argument("--poteto", action="store_true", help="stdin JSON retains exact fixed-prefix text and goal arguments")
    resume.add_argument("text", nargs="?")
    for name, (_method, _suffix, positionals, _build) in VERBS.items():
        verb = sub.add_parser(name)
        verb.add_argument("sid")
        for positional in positionals:
            verb.add_argument(positional)
        if name == "archive":
            verb.add_argument("--expected-idle", help="exact session/cwd/logical entry/generation JSON; refuse stale or busy replacement")
    args = p.parse_args(argv)
    if args.cmd in ("runtime", "capabilities"):
        code, data = req("GET", "/api/sessiond/runtime")
        ok = code == 200 and isinstance(data, dict) and data.get("component") == "sessiond" and isinstance(data.get("capabilities"), list) and all(isinstance(capability, str) for capability in data["capabilities"])
        missing = [capability for capability in ("sessions.maintenanceCheckpoint", "prompt.potetoArguments", "sessions.streamsDcrEvents", "prompt.controlGoal", "sessions.conditionalAdmission", "prompt.recoveryControl") if not ok or capability not in data["capabilities"]]
        if args.cmd == "capabilities":
            ok = ok and not missing
            return out({"ok": ok, "status": code, "runtime": data, "missing": missing}, ok)
        return out({"ok": ok, "status": code, "runtime": data}, ok)
    if args.cmd == "failure-ratify":
        try:
            body = _json_object(_text_input(None), "authenticated ratification envelope")
        except (UsageError, UnicodeError) as exc:
            return out({"ok": False, "error": str(exc)}, False)
        body["cwd"] = args.cwd
        sid = urllib.parse.quote(args.sid, safe="")
        code, data = req("POST", f"/api/sessions/{sid}/failure-recovery/ratify", body)
        ok = code == 200 and isinstance(data, dict) and not data.get("error")
        return out({"ok": ok, "status": code, "result": data}, ok)
    if args.cmd == "failure-boundary":
        sid = urllib.parse.quote(args.sid, safe="")
        code, data = req("POST", f"/api/sessions/{sid}/failure-boundary", {"cwd": args.cwd, "stream": args.stream, "root": args.root})
        ok = code == 200 and isinstance(data, dict) and not data.get("error")
        return out({"ok": ok, "status": code, "result": data}, ok)
    if args.cmd == "control-goal":
        try:
            return cmd_control_goal(args)
        except (UsageError, UnicodeError) as exc:
            return out({"ok": False, "error": str(exc)}, False)
    if args.cmd in ("command-run", "compact", "maintenance", "maintenance-resume", "maintenance-events"):
        try:
            return cmd_maintenance(args)
        except (UsageError, UnicodeError) as exc:
            return out({"ok": False, "error": str(exc)}, False)
    if args.cmd == "list":
        return cmd_list(args.cwd)
    if args.cmd == "spawn":
        return cmd_spawn(args.cwd)
    if args.cmd == "prompt":
        try:
            text, poteto_goal = _invocation_input(args)
        except (UsageError, UnicodeError) as exc:
            return out({"ok": False, "error": str(exc)}, False)
        if not text.strip():
            return out({"ok": False, "error": "empty prompt"}, False)
        streaming = "steer" if args.steer else "followUp" if args.follow_up else None
        automatic = None
        if args.automatic_admission is not None:
            try:
                automatic = json.loads(args.automatic_admission)
            except json.JSONDecodeError:
                return out({"ok": False, "error": "automatic admission must be a JSON object"}, False)
            if not isinstance(automatic, dict):
                return out({"ok": False, "error": "automatic admission must be a JSON object"}, False)
        return cmd_prompt(args.sid, text, streaming, args.delivery_id, automatic, poteto_goal)
    if args.cmd == "status":
        return cmd_status(args.sid)
    if args.cmd == "commands":
        return cmd_commands(args.sid)
    if args.cmd == "automatic-admission":
        body = {"allowed": args.mode == "on"}
        if args.expected_generation is not None:
            body["expectedGeneration"] = args.expected_generation
        code, data = req("POST", f"/api/sessions/{args.sid}/automatic-admission", body)
        ok = code == 200 and isinstance(data, dict) and not data.get("error")
        return out({"ok": ok, "status": code, "result": data}, ok)
    method, suffix, _positionals, build = VERBS[args.cmd]
    try:
        body = build(args)
    except UsageError as exc:
        return out({"ok": False, "error": str(exc)}, False)
    code, data = req(method, f"/api/sessions/{args.sid}/{suffix}", body)
    ok = code == 200 and not (isinstance(data, dict) and data.get("error"))
    return out({"ok": ok, "status": code, "result": data}, ok)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
